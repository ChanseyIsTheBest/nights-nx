+uint32_t FormatChannels(plume::RenderFormat format) {
+  using F = plume::RenderFormat;
+  switch (format) {
+  case F::R8_UNORM:
+  case F::R16_UNORM:
+  case F::R16_FLOAT:
+  case F::R32_FLOAT:
